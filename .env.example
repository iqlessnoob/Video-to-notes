# GEMINI_API_KEY: Required for Gemini AI API calls in prototype/fallback mode.
# Production deployments route AI requests through TRUSTED_BACKEND_URL.
# Configure these secrets via the Secrets panel in AI Studio.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# TRUSTED_BACKEND_URL: Base URL of the trusted server-side backend for Gemini requests,
# credit ledger deductions/refunds, Rewarded Ad SSV verification, and Play Billing verification.
TRUSTED_BACKEND_URL=https://api-pending-deployment.videotostudypdf.example.com/

# ADMOB_REWARDED_AD_UNIT_ID: Production Google AdMob Rewarded Ad Unit ID.
# Leave as UNCONFIGURED_PRODUCTION_AD_UNIT_ID during development to use Google's official test ad unit.
ADMOB_REWARDED_AD_UNIT_ID=UNCONFIGURED_PRODUCTION_AD_UNIT_ID

# PLAY_BILLING_SUBSCRIPTION_PRODUCT_ID: Production Google Play Console Subscription Product ID.
# Leave as UNCONFIGURED_SUBSCRIPTION_PRODUCT_ID until created in Google Play Console.
PLAY_BILLING_SUBSCRIPTION_PRODUCT_ID=UNCONFIGURED_SUBSCRIPTION_PRODUCT_ID
